{
  "name": "bmtacademy",
  "version": "1.0.0",
  "private": true,
  "description": "Site statique de BMT Green Academy (GitHub Pages) — outillage qualité uniquement, aucune étape de build.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate \"**/*.html\"",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:js": "eslint .",
    "check:links": "node scripts/check-links.mjs",
    "certificats:build": "node scripts/build-certificats.mjs",
    "test": "npm run lint && npm run check:links"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "html-validate": "^9.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
